<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:shortcutId="guard_start"
        android:shortcutLongLabel="@string/shortcut_start_long"
        android:shortcutShortLabel="@string/shortcut_start">
        <intent
            android:action="com.areyouasleep.action.SHORTCUT_START"
            android:targetClass="com.areyouasleep.MainActivity"
            android:targetPackage="com.areyouasleep" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:shortcutId="guard_pause"
        android:shortcutLongLabel="@string/shortcut_pause_long"
        android:shortcutShortLabel="@string/shortcut_pause">
        <intent
            android:action="com.areyouasleep.action.SHORTCUT_PAUSE"
            android:targetClass="com.areyouasleep.MainActivity"
            android:targetPackage="com.areyouasleep" />
    </shortcut>

</shortcuts>
